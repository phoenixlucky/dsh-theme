{
  "name": "@deepseek-ai/dsh-theme",
  "description": "Six selectable wallpaper themes and optional VIP interface styling for Web profiles",
  "version": "1.0.11",
  "author": {
    "name": "phoenixlucky",
    "url": "https://github.com/phoenixlucky"
  },
  "homepage": "https://github.com/phoenixlucky/dsh-theme#readme",
  "bugs": {
    "url": "https://github.com/phoenixlucky/dsh-theme/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "ui-theme",
    "wallpaper"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenixlucky/dsh-theme.git"
  },
  "type": "module",
  "scripts": {
    "sync:client-styles": "node scripts/sync-client-styles.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./public/assets/icons/wj-dreamlight.png",
    "./assets/*": "./lib/assets/*",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "assets/*.webp",
    "assets/font-license.txt",
    "assets/LICENSE-2.0.txt",
    "locale/*.json",
    "docs",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/assets",
    "public/assets",
    "lib/types/**/*.d.ts",
    "src/client/styles.css",
    "scripts/sync-client-styles.mjs"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0 || =0.2.2-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.1-rc.3 <0.3.0 || =0.2.2-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || =4.0.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || =4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.1-rc.3 <0.3.0 || =0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
